# Copie para .env e ajuste. NUNCA publique o .env. O servidor lê variáveis de ambiente (veja docs/INSTALACAO_LOCAL.md).
HOST=127.0.0.1
PORT=8765
# Endereço gravado nos QR codes. Local (IP da rede) só funciona no mesmo Wi-Fi.
PUBLIC_BASE_URL=http://127.0.0.1:8765
ESTABELECIMENTO=MesaFácil Sinuca
# demo = pagamentos FICTÍCIOS. webhook = recebe confirmações assinadas de um provedor (NÃO validado com Pix real).
PAYMENT_MODE=demo
WEBHOOK_SECRET=
# Senha inicial do admin (usada só no primeiro início; se vazia, é gerada e exibida uma vez no console).
ADMIN_PASSWORD=
PRICE_CENTS=500
TABLE_COUNT=10
# 1 = permite aprovar pagamento FICTÍCIO por celular da rede (apenas demonstração em rede confiável)
DEMO_REMOTE_PAY=0
# Prazos (segundos) e saúde do controlador
ORDER_TTL_S=600
COMMAND_TTL_S=1800
DEVICE_ONLINE_S=30
# 1 = recusa cobrança se o controlador estiver offline (padrão 1 no modo webhook)
REQUIRE_DEVICE_ONLINE=0
# Atrás de proxy/túnel confiável: usar o último X-Forwarded-For como IP e marcar cookie como Secure
TRUST_PROXY=0
COOKIE_SECURE=0
SINUCA_DB=./sinuca_demo.sqlite3
SINUCA_KEYS=./device_keys.json
